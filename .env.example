# Kopiraj ovaj fajl u ".env" i popuni prave vrednosti.
# NIKAD ne deli .env fajl niti ga postavljaj na javni git repo.

# --- AI provajder: popuni JEDAN od ova dva ključa ispod ---
#
# OPCIJA A — Groq: POTPUNO BESPLATNO, bez kartice. Dovoljno dobro za demo
# klijentu (par hiljada poruka dnevno besplatno). Napraviš ključ na:
# https://console.groq.com/keys (samo email, bez kartice)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OPCIJA B — Anthropic (Claude): plaćeno (naplata po poruci, par centi po
# razgovoru), ali najbolji kvalitet odgovora. Traži karticu na nalogu.
# Napraviš ključ na: https://console.anthropic.com/settings/keys
# Ako je GROQ_API_KEY gore popunjen, Groq ima prioritet — da bi se koristio
# Claude, ili obriši GROQ_API_KEY ili ostavi i jedan i drugi (tada serveru
# treba izmena da prioritet bude Claude, javi mi ako to poželiš).
ANTHROPIC_API_KEY=

# Lozinka za pregled "nepoznatih"/eskaliranih pitanja na /api/admin/unanswered?secret=...
ADMIN_SECRET=promeni-me

# Sajtovi sa kojih sme da se zove ovaj API (zarezom odvojeno). "*" = svi (ok za test).
ALLOWED_ORIGINS=*

# Port na kom lokalno radi server (host servisi obično sami podese svoj PORT)
PORT=3000

# MOCK_MODE=1 pokreće bota bez pravog API ključa i bez pravih troškova —
# vraća test-odgovor da bi se proverilo da server, baza znanja i widget rade.
# Za prave odgovore klijentima, ovo mora biti isključeno (0 ili obrisano) i
# ANTHROPIC_API_KEY mora biti podešen.
MOCK_MODE=0
